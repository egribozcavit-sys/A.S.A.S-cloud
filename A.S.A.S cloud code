@app.middleware("http")
async def sec_headers(req: Request, call_next):
    resp=await call_next(req)
    resp.headers["X-Content-Type-Options"]="nosniff"; resp.headers["X-Frame-Options"]="DENY"
    resp.headers["Referrer-Policy"]="no-referrer"; resp.headers["Content-Security-Policy"]="default-src 'none'; frame-ancestors 'none'"
    resp.headers["X-Request-ID"]=str(uuid.uuid4()); resp.headers["Cache-Control"]="no-store"
    if IS_PROD: resp.headers["Strict-Transport-Security"]="max-age=63072000; includeSubDomains; preload"
