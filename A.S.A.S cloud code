class Base(DeclarativeBase): pass
def uuid_str(): return str(uuid.uuid4())
def utc_now(): return datetime.now(timezone.utc)

class TenantStatus(str, Enum): ACTIVE="active"; SUSPENDED="suspended"; DELETED="deleted"
class NodeStatus(str, Enum): ONLINE="online"; OFFLINE="offline"; MAINTENANCE="maintenance"; FAILED="failed"; PROVISIONING="provisioning"
class NodeType(str, Enum): EDGE="edge"; ENERGY="energy"; COMPUTE="compute"; STORAGE="storage"; GATEWAY="gateway"
class Role(str, Enum): OWNER="owner"; ADMIN="admin"; DEVELOPER="developer"; VIEWER="viewer"

