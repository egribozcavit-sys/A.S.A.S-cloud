except: redis_client=None; REDIS_ENABLED=False
rate_store: Dict[str, List[float]]={}; rate_lock=threading.Lock()
def rate_limit(req: Request, key="global", limit=60, window=60):
    ip=req.client.host if req.client else "unknown"; rkey=f"rl:{key}:{ip}"; now=time.time()
    if REDIS_ENABLED:
        try:
            pipe=redis_client.pipeline(); pipe.zremrangebyscore(rkey,0,now-window); pipe.zcard(rkey); pipe.zadd(rkey,{str(uuid.uuid4()):now}); pipe.expire(rkey,window)
            _,cnt,_,_=pipe.execute()
            if cnt>=limit: raise HTTPException(429,"Rate limit")
            return
        except HTTPException: raise
        except: pass
    with rate_lock:
        lst=[t for t in rate_store.get(rkey,[]) if now-t<window]
        if len(lst)>=limit: raise HTTPException(429,"Rate limit")
        lst.append(now); rate_store[rkey]=lst

