    region: str=Field(pattern=r"^[a-z]+-[a-z]+-\d$"); cpu_cores: int=Field(ge=1, le=256); ram_gb: int=Field(ge=1, le=2048)
    disk_gb: int=Field(default=50, ge=10, le=10000); config: Optional[Dict]=None
    idempotency_key: str=Field(default_factory=lambda: secrets.token_hex(12))

class RegisterRequest(BaseModel):
