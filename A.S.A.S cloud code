@app.middleware("http")
async def sec_headers(req: Request, call_next):
    start=time.time()
    resp=await call_next(req)
    resp.headers["X-Content-Type-Options"]="nosniff"; resp.headers["X-Frame-Options"]="DENY"
    resp.headers["Referrer-Policy"]="no-referrer"; resp.headers["X-Request-ID"]=str(uuid.uuid4()); resp.headers["Cache-Control"]="no-store"
    resp.headers["X-Content-Hash"]=HASH_ALGO
    if IS_PROD: resp.headers["Strict-Transport-Security"]="max-age=63072000; includeSubDomains; preload"
    if PROM_ENABLED:
        try: LATENCY.observe(time.time()-start)
        except: pass
    return resp

