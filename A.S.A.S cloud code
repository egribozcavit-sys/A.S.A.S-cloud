@app.get("/metrics")
def metrics():
    if not PROM_ENABLED: return PlainTextResponse("# prometheus not installed\n")
    from prometheus_client import generate_latest, CONTENT_TYPE_LATEST
    try:
        with SessionLocal() as db:
            online=db.scalar(select(func.count()).select_from(CloudNode).where(CloudNode.status==NodeStatus.ONLINE.value)) or 0
            NODE_GAUGE.set(online)
    except: pass
    return PlainTextResponse(generate_latest().decode(), media_type=CONTENT_TYPE_LATEST)

@app.post("/api/v1/auth/register", status_code=201)
def register(payload: RegisterRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req, key="register", limit=5, window=300)
    tenant=db.scalar(select(Tenant).where(Tenant.name==payload.tenant_name.lower()))
    if not tenant:
        tenant=Tenant(name=payload.tenant_name.lower(), owner_email=payload.email.lower())
        db.add(tenant); db.commit(); db.refresh(tenant)
    if db.scalar(select(User).where(User.email==payload.email.lower())): raise HTTPException(409,"User var")
    user=User(email=payload.email.lower(), full_name=payload.full_name, password_hash=hash_password(payload.password), tenant_id=tenant.id, role=Role.OWNER.value)
    db.add(user); db.commit(); db.refresh(user)
    db.add(AuditLog(tenant_id=tenant.id, user_id=user.id, action="register", detail=payload.tenant_name))
    db.commit()
    return {"tenant":tenant.name, "user_id":user.id, "region":tenant.region_primary}

@app.post("/api/v1/auth/login")
def login(payload: LoginRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req, key="login", limit=10, window=60)
    user=db.scalar(select(User).where(User.email==payload.email.lower()))
    if not user or not verify_password(payload.password, user.password_hash):
        raise HTTPException(401,"Hatalı şifre")
    return {"access_token":create_access_token(user.id), "refresh_token":create_refresh_token(user.id), "token_type":"bearer", "tenant_id":user.tenant_id}

@app.post("/api/v1/cloud/nodes", status_code=201)
def create_node(payload: NodeCreate, cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    if PROM_ENABLED: REQ_COUNTER.labels(type=payload.type, region=payload.region).inc()
    exists=db.scalar(select(CloudNode).where(CloudNode.tenant_id==cu.tenant_id, CloudNode.name==payload.name.lower()))
    if exists: raise HTTPException(409,"Node ismi var")
    node=CloudNode(tenant_id=cu.tenant_id, name=payload.name.lower(), type=payload.type, region=payload.region, cpu_cores=payload.cpu_cores, ram_gb=payload.ram_gb, disk_gb=payload.disk_gb, config=json.dumps(payload.config) if payload.config else None, status=NodeStatus.ONLINE.value, last_heartbeat=utc_now())
    db.add(node); db.add(AuditLog(tenant_id=cu.tenant_id, user_id=cu.id, action="node_create", detail=f"{payload.type} {payload.name} {payload.region}"))
    db.commit(); db.refresh(node); return node

@app.get("/api/v1/cloud/nodes")
def list_nodes(cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    return db.scalars(select(CloudNode).where(CloudNode.tenant_id==cu.tenant_id).order_by(CloudNode.region, CloudNode.name)).all()

@app.get("/api/v1/cloud/energy/nodes")
def energy_nodes(cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    return db.scalars(select(CloudNode).where(CloudNode.tenant_id==cu.tenant_id, CloudNode.type==NodeType.ENERGY.value)).all()

@app.post("/api/v1/cloud/nodes/{node_id}/heartbeat")
def heartbeat(node_id: str, cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    n=db.get(CloudNode, node_id)
    if not n or n.tenant_id!=cu.tenant_id: raise HTTPException(404,"Yok")
    n.last_heartbeat=utc_now(); n.status=NodeStatus.ONLINE.value; n.version+=1; db.commit()
    return {"id":n.id, "status":n.status, "heartbeat":n.last_heartbeat, "version":n.version}

@app.delete("/api/v1/cloud/nodes/{node_id}", status_code=204)
def delete_node(node_id: str, cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    n=db.get(CloudNode, node_id)
    if not n or n.tenant_id!=cu.tenant_id: raise HTTPException(404,"Yok")
    db.delete(n); db.commit(); return

@app.get("/api/v1/cloud/overview")
def overview(cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    total=db.scalar(select(func.count()).select_from(CloudNode).where(CloudNode.tenant_id==cu.tenant_id)) or 0
    online=db.scalar(select(func.count()).select_from(CloudNode).where(CloudNode.tenant_id==cu.tenant_id, CloudNode.status==NodeStatus.ONLINE.value)) or 0
    energy=db.scalar(select(func.count()).select_from(CloudNode).where(CloudNode.tenant_id==cu.tenant_id, CloudNode.type==NodeType.ENERGY.value)) or 0
    edge=db.scalar(select(func.count()).select_from(CloudNode).where(CloudNode.tenant_id==cu.tenant_id, CloudNode.type==NodeType.EDGE.value)) or 0
    return {"tenant_id":cu.tenant_id, "total_nodes":total, "online":online, "offline":total-online, "energy_nodes":energy, "edge_nodes":edge, "hash_algo":HASH_ALGO, "env":ENV}

def _watcher_loop():
    while True:
        try:
            time.sleep(30)
            cutoff=utc_now()-timedelta(seconds=90)
            with SessionLocal() as db:
                stale=db.scalars(select(CloudNode).where(CloudNode.last_heartbeat!=None, CloudNode.last_heartbeat<cutoff, CloudNode.status==NodeStatus.ONLINE.value)).all()
                for n in stale:
                    n.status=NodeStatus.OFFLINE.value
                if stale: db.commit()
        except: time.sleep(5)

@app.on_event("startup")
def start_watcher():
    t=threading.Thread(target=_watcher_loop, daemon=True); t.start() 