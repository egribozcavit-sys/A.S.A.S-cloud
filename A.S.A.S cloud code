bearer_scheme=HTTPBearer(auto_error=False)
def get_db():
    db=SessionLocal()
    try: yield db
    finally: db.close()
def create_token(uid: str, typ: str, delta: timedelta):
    now=datetime.now(timezone.utc)
    payload={"sub":uid,"type":typ,"iat":int(now.timestamp()),"exp":int((now+delta).timestamp()),"jti":secrets.token_urlsafe(24),"iss":APP_NAME,"aud":"asas-cloud"}
    return jwt.encode(payload, JWT_SECRET, algorithm="HS256")
def create_access_token(uid: str): return create_token(uid,"access",timedelta(minutes=15))
def create_refresh_token(uid: str): return create_token(uid,"refresh",timedelta(days=7))
def current_user(creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)]):
    if not creds: raise HTTPException(401,"Auth gerekli")
    try: p=jwt.decode(creds.credentials, JWT_SECRET, algorithms=["HS256"], audience="asas-cloud")
    except: raise HTTPException(401,"Geçersiz")
    u=db.get(User, p.get("sub"))
    if not u: raise HTTPException(401,"Yok")
    return u

